FROM cypress/browsers:node18.12.0-chrome106-ff106

ENV APP=/usr/src/app
WORKDIR $APP

COPY . .

# Install client dependencies
WORKDIR $APP/client
RUN npm install
RUN ls -la cypress && find cypress -type f  # debug Cypress spec files

# Install server dependencies
WORKDIR $APP/plywood/server
RUN npm install

# Verify Cypress installation
WORKDIR $APP/client
RUN ./node_modules/.bin/cypress verify
