FROM cypress/browsers:node18.12.0-chrome106-ff106

ENV APP=/usr/src/app
WORKDIR $APP

# Copy everything at once (assuming . contains client, plywood, etc.)
COPY . .

# Install root dependencies
RUN npm install

# Install client dependencies
WORKDIR $APP/client
RUN npm install
RUN ls -la cypress  # debug step to confirm spec files are here

# Install plywood server deps
WORKDIR $APP/plywood/server
RUN npm install

# Verify Cypress installation
WORKDIR $APP/client
RUN ./node_modules/.bin/cypress verify
