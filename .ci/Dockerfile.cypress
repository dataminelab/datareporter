FROM cypress/browsers:node18.12.0-chrome106-ff106

ENV APP=/usr/src/app
WORKDIR $APP

COPY client $APP/client
COPY plywood $APP/plywood
COPY viz-lib $APP/viz-lib

WORKDIR $APP/client
RUN ls
RUN npm install

WORKDIR $APP
COPY . $APP

WORKDIR $APP/client
# Verify Cypress installation
RUN ./node_modules/.bin/cypress verify
