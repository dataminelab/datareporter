# write somethin gaobut each of the keys
# OPENAI_API_KEY: Your OpenAI API key for accessing AI services
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# POSTGRES_PASSWORD: Password for the PostgreSQL database
POSTGRES_PASSWORD=xxx

# REDASH_COOKIE_SECRET: Secret key for Redash cookies
REDASH_COOKIE_SECRET=xxx

# MAILCHIMP_API_KEY: API key for Mailchimp integration
MAILCHIMP_API_KEY=xxx

# MAILCHIMP_LIST_ID: List ID for Mailchimp audience
MAILCHIMP_LIST_ID=xxx

# CODE_COVERAGE: Enable or disable code coverage reports (true/false)
CODE_COVERAGE=false

# REDASH_MAIL_SERVER: SMTP server address for Redash email notifications
REDASH_MAIL_SERVER=smtp.sendgrid.net

# REDASH_MAIL_PORT: SMTP server port for Redash email notifications
REDASH_MAIL_PORT=587

# REDASH_MAIL_USE_TLS: Use TLS for SMTP connection (true/false)
REDASH_MAIL_USE_TLS=true

# REDASH_MAIL_USE_SSL: Use SSL for SMTP connection (true/false)
REDASH_MAIL_USE_SSL=false

# REDASH_MAIL_USERNAME: SMTP username for Redash email notifications
REDASH_MAIL_USERNAME=your_username

# REDASH_MAIL_PASSWORD: SMTP password for Redash email notifications
REDASH_MAIL_PASSWORD=your_password
