{
  "name": "redash-client",
  "version": "26.03.0-dev",
  "description": "The frontend part of Redash.",
  "main": "index.js",
  "scripts": {
    "start": "npm-run-all --parallel watch:viz webpack-dev-server",
    "localhost": "npm-run-all --parallel watch:viz webpack-dev-server-localhost",
    "dev": "npm-run-all --parallel watch:viz webpack-dev-server",
    "clean": "rm -rf dist",
    "clean-install:viz": "cd ../viz-lib && npm ci",
    "install:turnilo": "(cd app/components/TurniloComponent && npm i)",
    "test:turnilo": "cd app/components/TurniloComponent && npm run test",
    "build:start": "npm run clean && npm i && npm run build && npm run start",
    "build:viz": "(cd ../viz-lib && npm i && npm run build:babel)",
    "build:plywood-client": "(cd ../plywood/client && npm i && npm run compile)",
    "build:plywood-server": "(cd ../plywood && npm i && npm run build)",
    "build:plywood": "npm run build:plywood-client && npm run build:plywood-server",
    "build": "npm run clean && npm run build:viz && npm run build:plywood && NODE_OPTIONS=\"--max_old_space_size=4096\" NODE_ENV=production webpack",
    "build:old-node-version": "npm run clean && NODE_ENV=production node --max-old-space-size=4096 node_modules/.bin/webpack",
    "watch:app": "NODE_OPTIONS=\"--max_old_space_size=4096\" webpack watch --progress",
    "watch:plywood": "(cd ../plywood/client && npm run watch)",
    "watch:viz": "(cd ../viz-lib && npm run watch:babel)",
    "watch": "npm-run-all --parallel watch:*",
    "webpack-dev-server": "webpack-dev-server",
    "webpack-dev-server-localhost": "webpack-dev-server -- --host 0.0.0.0",
    "analyze": "npm run clean && BUNDLE_ANALYZER=on NODE_OPTIONS=\"--max_old_space_size=4096\" webpack",
    "analyze:build": "npm run clean && NODE_ENV=production BUNDLE_ANALYZER=on NODE_OPTIONS=\"--max_old_space_size=4096\" webpack",
    "lint": "npm run lint:base -- --ext .js --ext .jsx --ext .ts --ext .tsx .",
    "lint:fix": "npm run lint:base  -- --fix --ext .js --ext .jsx --ext .ts --ext .tsx .",
    "lint:base": "eslint --config ./.eslintrc.js",
    "lint:ci": "npm run lint -- --max-warnings 0 --format junit --output-file /tmp/test-results/eslint/results.xml",
    "prettier": "prettier --config ../.prettierrc.json --write \"**/*.{js,jsx,ts,tsx,json,css,scss,less,md}\" --ignore-path .prettierignore",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "type-check:watch": "npm run type-check -- --watch",
    "test": "TZ=Africa/Khartoum jest  --watchAll --coverage",
    "test:watch": "TZ=Africa/Khartoum jest --watch",
    "test:debug": "TZ=Africa/Khartoum node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:debug-file": "TZ=Africa/Khartoum node --inspect-brk node_modules/.bin/jest --runInBand --testPathPattern",
    "test:coverage": "TZ=Africa/Khartoum jest --coverage",
    "test:ci": "TZ=Africa/Khartoum jest --ci --coverage --watchAll=false",
    "test:silent": "TZ=Africa/Khartoum jest --silent",
    "test:percy": "TZ=Africa/Khartoum jest --testNamePattern='Percy'",
    "test:cypress-config": "TZ=Africa/Khartoum jest cypress/__tests__",
    "cypress": "node cypress/cypress.js",
    "preinstall": "npm run build:plywood",
    "clear": "rm -rf dist node_modules",
    "clear:all": "npm run clear && (cd ../viz-lib && npm run clear) && (cd ../plywood && npm run clear) && (cd ../plywood/client && npm run clear)",
    "rebuild": "npm run clear:all && npm i && npm run build",
    "postinstall": "npm run clean-install:viz && npm run build:viz && npm run install:turnilo",
    "cypress:restart": "npm run clear:all && npm i && npm run build && cd .. && bash bin/restart_cypress.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dataminelab/datareporter.git"
  },
