{
  "name": "plywood-server",
  "version": "1.0.2",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "watch-ts": "tsc -w",
    "watch-node": "nodemon --inspect=0.0.0.0:9229 -r ts-node/register dist/server.js",
    "watch": "concurrently -k -p \"[{name}]\" -n \"TypeScript, Node\" -c \"yellow.bold, cyan.bold\" \"npm run watch-ts\" \"npm run watch-node\"",
    "test": "mocha",
    "build": "tsc -p . && echo \"Plywood Server Built!\"",
    "full-build": "npm install && tsc -p .",
    "start": "node dist/server.js",
    "dev": "node --inspect=0.0.0.0:9229 --require ts-node/register src/server.ts",
    "dev:transpile": "node --inspect=0.0.0.0:9229 --require ts-node/register --transpile-only src/server.ts",
    "dev:watch": "nodemon --exec 'ts-node --transpile-only' src/server.ts",
    "dev:debug": "ts-node-dev --inspect=0.0.0.0:9229 --project tsconfig-dev.json --respawn --transpile-only src/server.debug.ts",
    "clear": "rm -rf dist node_modules",
    "prepare": "npm run build",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org data-reporter --project plywood ./dist && sentry-cli sourcemaps upload --org data-reporter --project plywood ./dist"
  },
  "dependencies": {
    "@druid-toolkit/query": "^0.19.1",
    "@sentry/cli": "^2.33.1",
    "@sentry/node": "^7.119.0",
    "@types/express": "^4.17.8",
    "body-parser": "^1.20.4",
    "chronoshift": "^0.10.0",
    "concurrently": "^5.3.0",
    "d3": "^3.5.17",
    "d3-dsv": "2.0.0",
    "dotenv": "^16.0.3",
    "druid-query-toolkit": "^0.19.1",
    "druid.d.ts": "^0.12.1",
    "express": "^4.22.1",
    "has-own-prop": "^2.0.0",
    "http-status": "^1.4.2",
    "immer": "^9.0.6",
    "immutable": "^4.0.0-rc.14",
    "immutable-class": "^0.9.4",
    "immutable-class-tester": "^0.7.2",
    "l": "^0.6.0",
    "lz-string": "^1.4.4",
    "moment-timezone": "^0.5.26",
    "numbro": "^2.4.0",
    "plywood-postgres-requester": "^1.4.0",
    "react": "^17.0.2",
    "reporter-plywood": "file:client",
    "sinon": "^11.1.1",
    "stream-to-array": "^2.3.0",
    "stream-to-string": "^1.2.0",
    "tslib": "^1.10.0",
    "tslog": "^4.9.3"
  },
  "devDependencies": {
    "@types/chai": "^4.2.12",
    "@types/chai-http": "^4.2.0",
    "@types/lz-string": "^1.3.34",
    "@types/mocha": "^8.1.3",
    "@types/node": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "chai": "^4.2.0",
    "chai-http": "^4.3.0",
    "eslint": "^7",
    "eslint-config-react-app": "^6",
    "eslint-plugin-compat": "^3.13.0",
    "eslint-plugin-cypress": "^2.15.2",
    "eslint-plugin-flowtype": "^5.10.0",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-jest": "^24.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-only-tests": "^2.6.0",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "mocha": "^8.1.3",
    "nodemon": "^2.0.22",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.3",
    "typescript": "^4.9.5"
  }
}
